/root></mxGraphModel></diagram><diagram id="page4" name="4 · glosa / PageIndex / docling-agent"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1140" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="Le même document, la même question — trois moteurs" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1300" height="30" as="geometry"/></mxCell><mxCell id="t2" value="Boîte violette = un appel LLM. Trait plein = chemin nominal ; pointillé = ne tourne que si le tour précédent n'a pas suffi." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1400" height="24" as="geometry"/></mxCell><mxCell id="LA" value="docling-agent v0.1.x  ·  _rag_loop" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=15;fontStyle=1;dashed=0;opacity=40;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="40" y="95" width="500" height="900" as="geometry"/></mxCell><mxCell id="LB" value="PageIndex" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=15;fontStyle=1;dashed=0;opacity=40;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="580" y="95" width="500" height="900" as="geometry"/></mxCell><mxCell id="LC" value="glosa" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=15;fontStyle=1;dashed=0;opacity=40;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1120" y="95" width="540" height="900" as="geometry"/></mxCell><mxCell id="achip" value="cas nominal : 2 appels par section lue" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=13;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="70" y="125" width="440" height="32" as="geometry"/></mxCell><mxCell id="bchip" value="cas nominal : N appels d'index, puis 2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=13;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="610" y="125" width="440" height="32" as="geometry"/></mxCell><mxCell id="cchip" value="cas nominal : 1 appel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1150" y="125" width="480" height="32" as="geometry"/></mxCell><mxCell id="a1" value="Pré-traitement : aucun" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="175" width="440" height="70" as="geometry"/></mxCell><mxCell id="b1" value="LLM × N nœuds · écrire un résumé&#10;avant même la première question" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="610" y="175" width="440" height="70" as="geometry"/></mxCell><mxCell id="c1" value="Projection Studio · 0 appel&#10;mêmes nœuds, mêmes ids, même ordre que l'UI" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1150" y="175" width="480" height="70" as="geometry"/></mxCell><mxCell id="a2" value="&lt;b&gt;La carte&lt;/b&gt;&#10;les titres, rien d'autre&#10;(labels = TITLE, SECTION_HEADER)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="70" y="265" width="440" height="95" as="geometry"/></mxCell><mxCell id="b2" value="&lt;b&gt;La carte&lt;/b&gt;&#10;un résumé écrit par un modèle&#10;pour chaque nœud" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="610" y="265" width="440" height="95" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;La carte&lt;/b&gt;&#10;titres + amorce de chaque section (sa 1re phrase, gratuite)&#10;montrée seulement si elle distingue · sautée en premier si le budget craque" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1150" y="265" width="480" height="95" as="geometry"/></mxCell><mxCell id="a3" value="LLM · choisir une section&#10;la carte entière est réinjectée à chaque tour" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="385" width="440" height="60" as="geometry"/></mxCell><mxCell id="b3" value="LLM · descendre l'arbre sur les résumés" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="610" y="385" width="440" height="60" as="geometry"/></mxCell><mxCell id="c3" value="BM25 + RRF (corps · titre · résumé) → shortlist + confiance&#10;quelques µs, 0 appel" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1150" y="385" width="480" height="60" as="geometry"/></mxCell><mxCell id="a4" value="LLM · lire la section" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="470" width="440" height="55" as="geometry"/></mxCell><mxCell id="b4" value="LLM · lire le nœud retenu" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="610" y="470" width="440" height="55" as="geometry"/></mxCell><mxCell id="c4" value="LLM × k · lire les candidats EN PARALLÈLE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1150" y="470" width="480" height="55" as="geometry"/></mxCell><mxCell id="a5" value="pas suffisant → tour suivant&#10;le contexte garde tout ce qui a déjà été lu" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="550" width="440" height="60" as="geometry"/></mxCell><mxCell id="b5" value="descente jusqu'à la feuille" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="610" y="550" width="440" height="60" as="geometry"/></mxCell><mxCell id="c5" value="Trace : answered / not_in_document / insufficient_evidence / budget_exhausted&#10;node_ids + page + bbox à chaque étape" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1150" y="550" width="480" height="60" as="geometry"/></mxCell><mxCell id="a6" value="réponse + section_ref + nb de caractères" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="640" width="440" height="50" as="geometry"/></mxCell><mxCell id="b6" value="réponse + nœud" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="610" y="640" width="440" height="50" as="geometry"/></mxCell><mxCell id="cesc" value="Escalade — n'entre en jeu que si le classement n'est pas sûr" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;fontStyle=2;dashed=1;opacity=50;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1150" y="635" width="480" height="190" as="geometry"/></mxCell><mxCell id="e1" value="LLM · écrire le vocabulaire de recherche, puis re-classer" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;dashed=1;opacity=70;" vertex="1" parent="1"><mxGeometry x="1170" y="678" width="440" height="42" as="geometry"/></mxCell><mxCell id="e2" value="LLM · choisir sur la carte&#10;on lit les deux : la piste lexicale ET celle du modèle" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;dashed=1;opacity=70;" vertex="1" parent="1"><mxGeometry x="1170" y="730" width="440" height="45" as="geometry"/></mxCell><mxCell id="e3" value="sinon : la note du lecteur devient la requête du tour suivant" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;dashed=1;opacity=70;" vertex="1" parent="1"><mxGeometry x="1170" y="785" width="440" height="32" as="geometry"/></mxCell><mxCell id="acost" value="&lt;b&gt;Coût&lt;/b&gt;&#10;2 appels séquentiels par section lue.&#10;Titres muets (« Article 7 ») → il tâtonne.&#10;Carte trop grosse → dépasse la fenêtre." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="70" y="880" width="440" height="100" as="geometry"/></mxCell><mxCell id="bcost" value="&lt;b&gt;Coût&lt;/b&gt;&#10;La meilleure carte des trois, payée d'avance :&#10;N appels par document, refaits à chaque version.&#10;Aucun prior lexical — tout passe par le modèle." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="610" y="880" width="440" height="100" as="geometry"/></mxCell><mxCell id="ccost" value="&lt;b&gt;Coût&lt;/b&gt;&#10;1 appel quand le vocabulaire de la question est dans le texte ; 2 avec l'expansion, 3 avec le hedge — et les lectures sont simultanées.&#10;Budget : pas · appels · deadline." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1150" y="880" width="480" height="100" as="geometry"/></mxCell><mxCell id="band" value="Mesuré sur le même document avec le même modèle scripté : la boucle select-read-decide coûte &lt;b&gt;4 appels&lt;/b&gt;, glosa &lt;b&gt;1&lt;/b&gt;. La boucle de référence n'est pas livrée — elle vit dans &lt;b&gt;tests/baseline.py&lt;/b&gt;, glosa n'a qu'une seule boucle de lecture.&#10;glosa ne génère jamais de résumé : quand l'hôte en a écrit un, il est classé (×1.5) ; sinon l'amorce prend le relais — gratuitement." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1020" width="1620" height="70" as="geometry"/></mxCell><mxCell id="ea0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ea1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a2" target="a3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ea2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a3" target="a4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ea3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#fff